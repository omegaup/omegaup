FROM ubuntu:jammy AS build

# Minimum php8.1 package revision that ships the PHP2Shell fixes
# (CVE-2026-109618 / CVE-2026-109619), per Ubuntu USN-8948-1 for jammy.
ARG PHP_MIN_SECURE_VERSION=8.1.2-1ubuntu2.28

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && \
    apt-get install --no-install-recommends -y \
        software-properties-common \
        && \
    apt-get update -y && \
    apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        curl \
        git \
        gnupg2 \
        php8.1-apcu \
        php8.1-cli \
        php8.1-curl \
        php8.1-gmp \
        php8.1-mbstring \
        php8.1-xml \
        php8.1-zip \
        && \
    /usr/sbin/update-ca-certificates && \
    apt-get autoremove -y && \
    apt-get clean

# Fail the build unless the required php8.1 core packages are installed AND
# at or above the PHP2Shell-fixed revision (CVE-2026-109618/109619).
# Each required package is checked explicitly: a missing package or a version
# below ${PHP_MIN_SECURE_VERSION} aborts the build. Third-party extensions
# (e.g. php8.1-apcu) carry their own upstream versioning and are not checked.
RUN set -eu; \
    min="${PHP_MIN_SECURE_VERSION}"; \
    for pkg in php8.1-cli php8.1-common php8.1-curl php8.1-gmp php8.1-mbstring php8.1-xml php8.1-zip; do \
        ver="$(dpkg-query -W -f='${db:Status-Abbrev} ${Version}' "$pkg" 2>/dev/null || true)"; \
        case "$ver" in \
            "ii "*) ver="${ver#ii }";; \
            *) echo "FATAL: required package $pkg is not installed (PHP2Shell check)"; exit 1;; \
        esac; \
        if ! dpkg --compare-versions "$ver" ge "$min"; then \
            echo "FATAL: $pkg $ver is older than $min (PHP2Shell fix missing)"; exit 1; \
        fi; \
        echo "OK: $pkg $ver >= $min"; \
    done

RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - && \
    apt-get install -y nodejs && \
    corepack enable

RUN apt-get update -y && \
    apt-get install --no-install-recommends -y nginx nodejs && \
    apt-get autoremove -y && \
    apt-get clean

RUN curl -sL https://getcomposer.org/download/2.1.14/composer.phar -o /usr/bin/composer && \
    chmod +x /usr/bin/composer

RUN useradd --create-home --shell=/bin/bash ubuntu
RUN mkdir -p /opt/omegaup /var/lib/omegaup/templates /var/log/omegaup && chown -R ubuntu /opt/omegaup /var/lib/omegaup /var/log/omegaup
USER ubuntu
WORKDIR /opt/omegaup
ARG BRANCH=release
ENV BRANCH=$BRANCH
RUN git clone --branch=${BRANCH} --depth=1 --recurse-submodules --shallow-submodules https://github.com/omegaup/omegaup .
WORKDIR /opt/omegaup/frontend/www/rekarel
RUN npm install && npx gulp && npm run build
WORKDIR /opt/omegaup
RUN corepack enable && pnpm install --frozen-lockfile && pnpm build
RUN composer install --no-dev --classmap-authoritative
RUN printf "<?php\n\
define('OMEGAUP_ENVIRONMENT', 'production');\n\
define('OMEGAUP_CACHE_IMPLEMENTATION', 'none');\n\
define('TEMPLATE_CACHE_DIR', '/var/lib/omegaup/templates');\n" > frontend/server/config.php
RUN php frontend/server/cmd/CompileTemplatesCmd.php

FROM alpine:latest AS frontend
RUN apk add rsync
RUN mkdir -p /var/lib/omegaup/templates /opt/omegaup
COPY --from=build /opt/omegaup /opt/omegaup
COPY --from=build /opt/omegaup/frontend/www/rekarel/. /opt/omegaup/frontend/www/rekarel/
COPY --from=build /var/lib/omegaup /var/lib/omegaup

FROM ubuntu:jammy AS nginx

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && \
    apt-get install --no-install-recommends -y nginx ca-certificates && \
    /usr/sbin/update-ca-certificates && \
    apt-get autoremove -y && \
    apt-get clean

RUN useradd --create-home --shell=/bin/bash ubuntu

RUN mkdir -p /etc/omegaup/frontend
RUN mkdir -p /var/log/omegaup && chown -R ubuntu /var/log/omegaup

USER ubuntu
WORKDIR /opt/omegaup

EXPOSE 8001

CMD ["/usr/sbin/nginx"]

FROM ubuntu:jammy AS php

# Minimum php8.1 package revision that ships the PHP2Shell fixes
# (CVE-2026-109618 / CVE-2026-109619), per Ubuntu USN-8948-1 for jammy.
ARG PHP_MIN_SECURE_VERSION=8.1.2-1ubuntu2.28

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && \
    apt-get install --no-install-recommends -y \
        curl \
        gnupg \
        ca-certificates \
        software-properties-common \
        && \
    /usr/sbin/update-ca-certificates && \
    echo 'deb http://apt.newrelic.com/debian/ newrelic non-free' > /etc/apt/sources.list.d/newrelic.list && \
    curl -sL https://download.newrelic.com/548C16BF.gpg | apt-key add - && \
    apt-get update -y && \
    apt-get install --no-install-recommends -y \
        newrelic-php5 \
        openjdk-18-jre-headless \
        php8.1-apcu \
        php8.1-curl \
        php8.1-fpm \
        php8.1-gmp \
        php8.1-mbstring \
        php8.1-mysql \
        php8.1-opcache \
        php8.1-redis \
        php8.1-xml \
        php8.1-zip \
        && \
    apt-get autoremove -y && \
    apt-get clean

# Fail the build unless the required php8.1 core packages are installed AND
# at or above the PHP2Shell-fixed revision (CVE-2026-109618/109619), per
# Ubuntu USN-8948-1 for jammy. Each required core package is checked
# explicitly: a missing package or a version below ${PHP_MIN_SECURE_VERSION}
# aborts the build. Third-party extensions (php8.1-apcu, php8.1-redis, ...)
# carry their own upstream versioning and are intentionally not checked.
RUN set -eu; \
    min="${PHP_MIN_SECURE_VERSION}"; \
    for pkg in php8.1-cli php8.1-common php8.1-curl php8.1-fpm php8.1-gmp \
               php8.1-mbstring php8.1-mysql php8.1-opcache php8.1-readline \
               php8.1-xml php8.1-zip; do \
        ver="$(dpkg-query -W -f='${db:Status-Abbrev} ${Version}' "$pkg" 2>/dev/null || true)"; \
        case "$ver" in \
            "ii "*) ver="${ver#ii }";; \
            *) echo "FATAL: required package $pkg is not installed (PHP2Shell check)"; exit 1;; \
        esac; \
        if ! dpkg --compare-versions "$ver" ge "$min"; then \
            echo "FATAL: $pkg $ver is older than $min (PHP2Shell fix missing)"; exit 1; \
        fi; \
        echo "OK: $pkg $ver >= $min"; \
    done; \
    php-fpm8.1 -v

RUN curl -sL https://github.com/omegaup/libinteractive/releases/download/v2.0.27/libinteractive.jar \
        -o /usr/share/java/libinteractive.jar

RUN useradd --create-home --shell=/bin/bash ubuntu && \
    mkdir -p /etc/omegaup/frontend && \
    mkdir -p /var/log/omegaup /var/lib/omegaup /opt/omegaup && \
    chown -R ubuntu /var/log/omegaup /var/lib/omegaup /opt/omegaup

RUN rm -rf /etc/php/8.1/fpm/pool.d/

USER ubuntu
WORKDIR /opt/omegaup

# Override stop signal to stop process gracefully
# # https://github.com/php/php-src/blob/17baa87faddc2550def3ae7314236826bc1b1398/sapi/fpm/php-fpm.8.in#L163
STOPSIGNAL SIGQUIT
EXPOSE 9001

CMD ["php-fpm8.1", "--nodaemonize", "--force-stderr"]

FROM ubuntu:jammy as frontend-sidecar

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -y && \
    apt-get install --no-install-recommends -y \
        ca-certificates \
        curl \
        git \
        mysql-client-core-8.0 \
        python3-pip \
        && \
    apt-get autoremove -y && \
    apt-get clean

COPY requirements.txt /tmp/
RUN python3 -m pip install -r /tmp/requirements.txt && rm /tmp/requirements.txt

RUN useradd --create-home --shell=/bin/bash ubuntu && \
    mkdir -p /etc/omegaup/frontend && \
    mkdir -p /var/log/omegaup && chown -R ubuntu /var/log/omegaup && \
    mkdir /opt/omegaup && \
    chown -R ubuntu /opt/omegaup

USER ubuntu
WORKDIR /opt/omegaup
